[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node2D

## Greybox de bloque urbano - solo para VER escala, camara y rutas.
## No es arte final. El prototipo de Fase 1 (main_test.tscn) queda intacto.

@onready var fps_label: Label = $TouchHUD/FPSCounter

func _process(_delta: float) -> void:
	if fps_label:
		fps_label.text = \"DISTRITO 23 // GREYBOX CIUDAD // \" + str(Engine.get_frames_per_second()) + \" FPS\"
"

