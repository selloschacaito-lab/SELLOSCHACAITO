<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.selloschacaito.impresion" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Sellos Chacaito - Plugin de Impresión" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.selloschacaito.impresion.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Adobe Illustrator CS6 to CC 2026+ -->
            <Host Name="ILST" Version="[16.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="6.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.selloschacaito.impresion.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEPEngineRefs>
                        <CEPEngineRef>Node</CEPEngineRef>
                    </CEPEngineRefs>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Sellos Chacaíto - Impresión</Menu>
                    <Geometry>
                        <Size>
                            <Height>650</Height>
                            <Width>380</Width>
                        </Size>
                        <MinSize>
                            <Height>450</Height>
                            <Width>300</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1200</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
